  <property name="styleSheet">
   <string notr="true">/* Genel Arka Plan ve Yazı Rengi */
QWidget {
    background-color: #121212;
    color: #E0E0E0;
}

/* QPushButton - Belirgin Buton + Gölgelendirme */
QPushButton {
    background-color: #00AEEF;
    font: bold 14pt &quot;Segoe UI&quot;;
    color: white;
    font-weight: bold; /* Yazı kalın */
    border: none;
    border-radius: 6px;
    padding: 8px 16px;
    box-shadow: 0px 4px 10px rgba(0, 174, 239, 0.6); /* Daha belirgin gölge */
    transition: background-color 0.3s ease;
}

QPushButton:hover {
    background-color: #D32F2F;
    box-shadow: 0px 4px 10px rgba(211, 47, 47, 0.7); /* Hover gölgesi */
}

QPushButton:pressed {
    background-color: #B71C1C;
    box-shadow: inset 0px 2px 4px rgba(0,0,0,0.4); /* Basılı efekti */
}


/* QLineEdit - Belirginlik İçin */
QLineEdit {
    background-color: #1E1E1E;
    color: #E0E0E0;
    border: 1px solid #555;
    border-radius: 4px;
    padding: 6px;
}

/* QComboBox */
QComboBox {
    background-color: #1E1E1E;
    color: #E0E0E0;
    border: 1px solid #555;
    border-radius: 4px;
    padding: 6px;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 25px;
    background-color: #2A2A2A;
    border-left: 1px solid #555;
}

QComboBox::down-arrow {
    width: 10px;
    height: 10px;
    image: none; /* Kendi ikonunu kullanacaksan url() ekle */
}

/* Açılır liste görünümü */
QComboBox QAbstractItemView {
    background-color: #2A2A2A;
    color: #E0E0E0;
    selection-background-color: #455A64;
    selection-color: white;
    border: 1px solid #444;
}

/* Tablo Başlıkları */
QHeaderView::section {
    background-color: #E0E0E0;
    color: black;
    font-weight: bold;
    padding: 6px;
    border: none;
}

/* QTableView */
QTableView {
    background-color: #1E1E1E;
    alternate-background-color: #2A2A2A;
    gridline-color: #444;
    color: #E0E0E0;
    selection-background-color: #455A64;
    selection-color: white;
    border: 1px solid #333;
}

QTableView::item {
    padding: 4px;
}
</string>
